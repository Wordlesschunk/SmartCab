{% extends 'base.html.twig' %}

{% block title %}Cabinet{% endblock %}

{% block body %}
    <h1>Cabinet</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ cabinet.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ cabinet.name }}</td>
            </tr>
            <tr>
                <th>IpAddress</th>
                <td>{{ cabinet.ipAddress }}</td>
            </tr>
            <tr>
                <th>DrawerCount</th>
                <td>{{ cabinet.drawerCount }}</td>
            </tr>
            <tr>
                <th>LEDCount</th>
                <td>{{ cabinet.lEDCount }}</td>
            </tr>
        </tbody>
    </table>

    <h1>Drawers Mappings</h1>
    <hr>

    <table class="table">
        <thead>
        <tr>
            <th>Drawer</th>
            <th>Label</th>
            <th>Position</th>
            <th>Preferred Position</th>
            <th>Action</th>
        </tr>
        </thead>
        <tbody>
        {% for drawer in cabinet.drawers %}
        <tr>
            <td>{{ drawer.id }}</td>
            <td>{{ drawer.label }}</td>
            <td>{{ drawer.position }}</td>
            <td>
                <twig:InlineEditDrawerLEDPosition :drawer="drawer"/>
            </td>
            <td>
                <a href="{{ path('drawer_power_on', { 'id': drawer.id }) }}" class="btn btn-sm btn-info">
                    Test
                </a>
            </td>
        </tr>
        {% endfor %}
        </tbody>
    </table>

    <div>
        <h3>Power Settings (DEBUG)</h3>
        <a href="{{ path('cab_on', { 'id': cabinet.id }) }}" class="btn btn-sm btn-info">
            Power On
        </a>
        <a href="{{ path('cab_off', { 'id': cabinet.id }) }}" class="btn btn-sm btn-info">
            Power Off
        </a>
        <a href="{{ path('cab_on_single', { 'id': cabinet.id }) }}" class="btn btn-sm btn-info">
            Power On Single
        </a>
    </div>

    <a href="{{ path('app_cabinet_index') }}">back to list</a>

    <a href="{{ path('app_cabinet_edit', {'id': cabinet.id}) }}">edit</a>

    {{ include('cabinet/_delete_form.html.twig') }}
{% endblock %}
